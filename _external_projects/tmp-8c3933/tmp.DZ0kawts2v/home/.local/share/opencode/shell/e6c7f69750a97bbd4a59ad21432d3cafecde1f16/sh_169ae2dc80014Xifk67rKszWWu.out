3ca  ..m..s..:,uH..3.\n00000020: fa40 4c80 47f6 4785 d7b5 8d0b ce8c a44b  .@L.G.G........K\n00000030: 1739 f0a6 e767 53dc be1d 1020 abe2 474a  .9...gS.... ..GJ\n---oc-save---\n#!/usr/bin/env bash\nset -e\ncd \"$WORKSPACE_DIR\"\nif [ -f /tmp/protected-workflow.yml ]; then\n  mkdir -p .github/workflows\n  cp /tmp/protected-workflow.yml .github/workflows/opencode-web.yml\nfi\nTARGETS=()\n[ -d \"$HOME/.local/share/opencode\" ] && TARGETS+=(\".local/share/opencode\")\n[ -d \"$HOME/.config/opencode\" ] && TARGETS+=(\".config/opencode\")\n[ -d \"$HOME/.local/state/opencode\" ] && TARGETS+=(\".local/state/opencode\")\nif [ \"${#TARGETS[@]}\" -gt 0 ] && [ -n \"$FINAL_PW\" ]; then\n  tar -czf - -C \"$HOME\" \\\n    --exclude='.local/share/opencode/log' \\\n    --exclude='.local/state/opencode/locks' \\\n    --exclude='.local/state/opencode/service.json' \\\n    \"${TARGETS[@]}\" 2>/dev/null \\\n    | openssl enc -aes-256-cbc -salt -pbkdf2 -pass env:FINAL_PW -out .opencode-backup.enc.tmp\n  mv .opencode-backup.enc.tmp .opencode-backup.enc\nfi\ngit add -A\ngit diff --cached --name-only | while IFS= read -r file; do\n  if [ -f \"$file\" ]; then\n    size=$(wc -c < \"$file\" 2>/dev/null || echo 0)\n    if [ \"$size\" -gt 99000000 ]; then\n      echo \"Melewati file >95MB dari git push (tetap bisa diunduh lewat Cloud Panel): $file\"\n      git reset HEAD \"$file\" >/dev/null 2>&1 || true\n    fi\n  fi\ndone\nif ! git diff --cached --quiet; then\n  git commit -m \"${1:-chore: auto-save kode & session OpenCode}\"\n  git pull --rebase --autostash || true\n  git push || true\nfi\n---oc-publish---\n#!/usr/bin/env bash\nNEW_URL=\"$1\"\n[ -z \"$NEW_URL\" ] && exit 0\necho \"$NEW_URL\" > /tmp/current_url.txt\n\nOWNER=\"${GITHUB_REPOSITORY%/*}\"\nREPO=\"${GITHUB_REPOSITORY#*/}\"\nOWNER_LOWER=$(echo \"$OWNER\" | tr '[:upper:]' '[:lower:]')\nPAGES_URL=\"https://${OWNER_LOWER}.github.io/${REPO}/\"\necho \"$PAGES_URL\" > /tmp/pages_url.txt\n\nif [ -n \"$GITHUB_REPOSITORY\" ] && [ -n \"$GH_TOKEN\" ]; then\n  TMP_PAGES=$(mktemp -d)\n  (\n    cd \"$TMP_PAGES\"\n    git init -q -b gh-pages\n    git config user.name \"OpenCode Cloud\"\n    git config user.email \"bot@opencode.local\"\n    NOW_WIB=$(TZ=Asia/Jakarta date '+%d %b %Y %H:%M WIB')\n    cat << HTMLEOF > index.html\n<!doctype html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>OpenCode Cloud Redirect</title>\n  <meta http-equiv=\"refresh\" content=\"2;url=${NEW_URL}\" />\n  <style>\n    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }\n    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0b0d12; color: #f3f4f6; padding: 18px; text-align: center; }\n    .box { width: 100%; max-width: 430px; background: #161922; border: 1px solid #2a2f3d; border-radius: 18px; padding: 28px 24px; box-shadow: 0 20px 50px rgba(0,0,0,.5); }\n    .badge { display: inline-block; background: #064e3b; color: #6ee7b7; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; }\n    h1 { margin: 0 0 8px; font-size: 21px; }\n    p { margin: 0 0 20px; font-size: 14px; color: #9ca3af; line-height: 1.5; }\n    a.btn { display: block; width: 100%; padding: 13px; border-radius: 11px; background: #3b82f6; color: #fff; text-decoration: none; font-weight: 600; font-size: 15px; margin-bottom: 10px; }\n    a.sub { display: block; width: 100%; padding: 11px; border-radius: 11px; background: #1f2433; border: 1px solid #32394e; color: #d1d5db; text-decoration: none; font-size: 13px; }\n    .meta { margin-top: 16px; font-size: 12px; color: #6b7280; }\n  </style>\n</head>\n<body>\n  <div class=\"box\">\n    <div class=\"badge\">● SERVER CLOUD AKTIF</div>\n    <h1>🚀 Mengarahkan ke OpenCode Web...</h1>\n    <p>Otomatis berpindah dalam 2 detik. Jika belum berpindah, klik tombol di bawah:</p>\n    <a class=\"btn\" href=\"${NEW_URL}\">Buka OpenCode Web Sekarang →</a>\n    <a class=\"sub\" href=\"${NEW_URL}/__panel\">⚙️ Buka Cloud Control Panel</a>\n    <div class=\"meta\">Diperbarui otomatis: ${NOW_WIB}</div>\n  </div>\n</body>\n</html>\nHTMLEOF\n    touch .nojekyll\n    git add -A\n    git commit -q -m \"chore: update active OpenCode URL\"\n    git push -f -q \"https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git\" gh-pages >/dev/null 2>&1 || true\n  )\n  rm -rf \"$TMP_PAGES\"\n\n  gh api -X POST \"repos/${GITHUB_REPOSITORY}/pages\" \\\n    -f \"source[branch]=gh-pages\" -f \"source[path]=/\" >/dev/null 2>&1 || true\nfi\n\nif [ -n \"$TELEGRAM_BOT_TOKEN\" ] && [ -n \"$TELEGRAM_CHAT_ID\" ]; then\n  MSG=\"🚀 *OpenCode Cloud Pro Aktif!*%0A%0A🌐 *Link Sesi Ini:*%0A${NEW_URL}%0A%0A🔗 *Link Permanen:*%0A${PAGES_URL}%0A%0A⚙️ *Control Panel:*%0A${NEW_URL}/__panel\"\n  curl -4 -fsS -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n    -d \"chat_id=${TELEGRAM_CHAT_ID}\" \\\n    -d \"parse_mode=Markdown\" \\\n    -d \"text=${MSG}\" >/dev/null 2>&1 || true\nfi\n\nif [ -n \"$DISCORD_WEBHOOK_URL\" ]; then\n  PAYLOAD=$(printf '{\"content\":\"🚀 **OpenCode Cloud Pro Aktif!**\\\\n🌐 **Link Sesi Ini:** %s\\\\n🔗 **Link Permanen:** %s\\\\n⚙️ **Control Panel:** %s/__panel\"}' \"$NEW_URL\" \"$PAGES_URL\" \"$NEW_URL\")\n  curl -4 -fsS -X POST \"$DISCORD_WEBHOOK_URL\" \\\n    -H \"Content-Type: application/json\" \\\n    -d \"$PAYLOAD\" >/dev/null 2>&1 || true\nfi\n"}],"metadata":{"status":"completed","truncated":false,"exit":0}},"time":{"created":1792774124532,"ran":1792774124613,"completed":1792774124624}}],"finish":"tool-calls","rawFinish":"tool_calls","cost":0,"tokens":{"input":233,"output":330,"reasoning":0,"cache":{"read":23936,"write":0}}}
