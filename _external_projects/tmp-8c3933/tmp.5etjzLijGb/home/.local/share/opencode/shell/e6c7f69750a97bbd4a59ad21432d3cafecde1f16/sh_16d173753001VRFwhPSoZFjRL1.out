timestamp=2026-10-24T08:37:42.615Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.cookiejar\\nimport json\\n\\ncj = http.cookiejar.CookieJar()\\nopener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n}\\n\\n# The KittyKawai page for Arachu Cantik Mulus has post_id=311016\\n# Let's try to get the video data via the Clean Tube Player API\\n# with different parameters\\n\\npost_id = \\\"311016\\\"\\n\\n# Try different API endpoints\\napi_endpoints = [\\n    f\\\"https://kittykawai.com/wp-content/plugins/clean-tube-player/public/player-x.php?q=post_id={post_id}&type=video\\\",\\n    f\\\"https://kittykawai.com/wp-json/ctpl/v1/video/{post_id}\\\",\\n    f\\\"https://kittykawai.com/wp-json/ultimatube/v1/video/{post_id}\\\",\\n    f\\\"https://kittykawai.com/wp-json/ultimatube/videos/{post_id}\\\",\\n]\\n\\nfor api in api_endpoints:\\n    try:\\n        req = urllib.request.Request(api, headers=headers)\\n        with urllib.request.urlopen(req, timeout=5) as response:\\n            data = response.read().decode('utf-8', errors='replace')\\n            if len(data) > 0:\\n                print(f\\\"{api}\\\")\\n                print(f\\\"  Length: {len(data)}\\\")\\n                print(f\\\"  Content: {data[:300]}\\\")\\n                # Look for MP4\\n                mp4 = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', data)\\n                if mp4:\\n                    for m in mp4:\\n                        print(f\\\"  MP4: {m}\\\")\\n            else:\\n                print(f\\\"{api}: empty response\\\")\\n    except Exception as e:\\n        print(f\\\"{api}: {e}\\\")\\n\\n# Also try getting the video via the YouTube oEmbed API\\nprint(\\\"\\\\n=== Checking oEmbed API ===\\\")\\ntry:\\n    url = f\\\"https://kittykawai.com/wp-json/oembed/1.0/embed?url=https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/&format=json\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        data = response.read().decode('utf-8', errors='replace')\\n        print(f\\\"oEmbed response: {data[:500]}\\\")\\nexcept Exception as e:\\n    print(f\\\"oEmbed error: {e}\\\")\\n\\n# Try getting the full video data from the WordPress REST API\\nprint(\\\"\\\\n=== WordPress REST API ===\\\")\\ntry:\\n    url = f\\\"https://kittykawai.com/wp-json/wp/v2/posts/311016\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        data = response.read().decode('utf-8', errors='replace')\\n        print(f\\\"REST API response ({len(data)} bytes):\\\")\\n        # Look for video URL\\n        mp4 = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', data)\\n        if mp4:\\n            for m in mp4:\\n                print(f\\\"  MP4: {m}\\\")\\n        else:\\n            # Look for embed URL\\n            embed = re.findall(r'(https?://playmogo\\\\.com/[ed]/\\\\w+)', data)\\n            if embed:\\n                print(f\\\"  Embed: {embed[0]}\\\")\\nexcept Exception as e:\\n    print(f\\\"REST API error: {e}\\\")\\n\\n# Try the post content to find video data\\nprint(\\\"\\\\n=== Getting post content ===\\\")\\ntry:\\n    url = f\\\"https://kittykawai.com/wp-json/wp/v2/posts/311016\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        data = response.read().decode('utf-8', errors='replace')\\n        parsed = json.loads(data)\\n        content = parsed.get('content', {}).get('rendered', '') if isinstance(parsed.get('content'), dict) else parsed.get('content', '')\\n        # Find all URLs in content\\n        urls = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+)', content)\\n        for u in urls:\\n            if 'mp4' in u.lower() or 'video' in u.lower() or 'dood' in u.lower() or 'stream' in u.lower():\\n                print(f\\\"  Content URL: {u}\\\")\\nexcept Exception as e:\\n    print(f\\\"Content error: {e}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5428032 role=server
timestamp=2026-10-24T08:37:58.839Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport base64\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n}\\n\\n# Get the actual page content and look for the video source\\nurl = \\\"https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    page = response.read().decode('utf-8', errors='replace')\\n\\n# Look for the Clean Tube Player shortcode in the page\\nprint(\\\"=== Looking for Clean Tube Player shortcode ===\\\")\\nshortcodes = re.findall(r'\\\\[clean-tube[^\\\\]]*\\\\]', page)\\nfor sc in shortcodes:\\n    print(f\\\"  {sc}\\\")\\n\\n# Look for wpst-video shortcode\\nwpst = re.findall(r'\\\\[wpst-[^\\\\]]*\\\\]', page)\\nfor w in wpst:\\n    print(f\\\"  wpst: {w[:200]}\\\")\\n\\n# Look for the video ID in the page\\nprint(\\\"\\\\n=== Looking for video ID in page ===\\\")\\nvideo_ids = re.findall(r'wpst-video-id[\\\"\\\\']?\\\\s*[=:]\\\\s*[\\\"\\\\']?(\\\\d+)[\\\"\\\\']?', page)\\nfor vid in video_ids:\\n    print(f\\\"  Video ID: {vid}\\\")\\n\\n# Look for the video post ID in any data attribute\\ndata_vid = re.findall(r'data-video-id=\\\"(\\\\d+)\\\"', page)\\nfor dv in data_vid:\\n    print(f\\\"  Data video ID: {dv}\\\")\\n\\n# Look for the video shortcode in the article content\\nprint(\\\"\\\\n=== Article video shortcode ===\\\")\\narticle = re.search(r'<article[^>]*id=\\\"post-311016\\\"[^>]*>(.*?)</article>', page, re.DOTALL)\\nif article:\\n    content = article.group(1)\\n    # Look for shortcode patterns\\n    shortcodes = re.findall(r'\\\\[[a-z-]+[^\\\\]]*\\\\]', content)\\n    for sc in shortcodes:\\n        print(f\\\"  {sc[:200]}\\\")\\n    \\n    # Look for iframe src in article\\n    iframes = re.findall(r'src=\\\"([^\\\"]*)\\\"', content)\\n    for iframe in iframes:\\n        if 'playmogo' in iframe or 'dood' in iframe or 'video' in iframe.lower():\\n            print(f\\\"  Article iframe: {iframe}\\\")\\n    \\n    # Look for any video-related element\\n    video_elements = re.findall(r'<(video|source|iframe|embed)[^>]*>', content[:20000])\\n    for ve in video_elements:\\n        print(f\\\"  Video element: {ve[:200]}\\\")\\n\\n# The iframe src is playmogo.com/e/wyr99ofrib7b\\n# Let's try to get the video URL from playmogo using a different method\\nprint(\\\"\\\\n=== Trying playmogo with different headers ===\\\")\\n# Try with Referer from the KittyKawai page\\nreq2 = urllib.request.Request(\\\"https://playmogo.com/e/wyr99ofrib7b\\\", headers={\\n    'User-Agent': headers['User-Agent'],\\n    'Referer': 'https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/',\\n    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',\\n    'Accept-Language': 'en-US,en;q=0.5',\\n})\\nwith urllib.request.urlopen(req2, timeout=10) as response2:\\n    pm_page = response2.read().decode('utf-8', errors='replace')\\n\\n# Save and analyze\\nwith open('/tmp/playmogo_e.html', 'w') as f:\\n    f.write(pm_page)\\n\\nprint(f\\\"Playmogo page size: {len(pm_page)}\\\")\\n\\n# Look for the video source in the playmogo page\\nprint(\\\"\\\\n=== Playmogo video source ===\\\")\\n# Look for script content\\nscripts = re.findall(r'<script[^>]*>(.*?)</script>', pm_page, re.DOTALL)\\nfor script in scripts:\\n    if 'video' in script.lower() or 'dood' in script.lower():\\n        print(f\\\"Script: {script[:500]}\\\")\\n\\n# Look for any URL in the page\\nurls = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+)', pm_page)\\nfor u in urls:\\n    print(f\\\"  URL: {u[:200]}\\\")\\n\\n# The video is on DoodStream. Let's try the DoodStream API directly\\n# with the file ID and the embed URL\\nprint(\\\"\\\\n=== DoodStream API call ===\\\")\\ntry:\\n    import json\\n    # The DoodStream API at doodapi.com needs an API key\\n    # But we can try the public endpoint\\n    api_url = \\\"https://doodapi.com/api/file/wyr99ofrib7b\\\"\\n    req3 = urllib.request.Request(api_url, headers={**headers, 'Referer': 'https://kittykawai.com/'})\\n    with urllib.request.urlopen(req3, timeout=5) as response3:\\n        data = response3.read().decode('utf-8', errors='replace')\\n        print(f\\\"API: {data[:300]}\\\")\\nexcept Exception as e:\\n    print(f\\\"API Error: {e}\\\")\\n\\n# Try to get the video URL from the DoodStream embed page using the API\\nprint(\\\"\\\\n=== DoodStream embed API ===\\\")\\n# DoodStream has a public API endpoint\\napi_urls = [\\n    \\\"https://doodapi.com/api/hoster\\\",\\n    \\\"https://doodapi.com/api/file_info/wyr99ofrib7b\\\",\\n]\\nfor api_url in api_urls:\\n    try:\\n        req = urllib.request.Request(api_url, headers={**headers, 'Referer': 'https://kittykawai.com/'})\\n        with urllib.request.urlopen(req, timeout=5) as response:\\n            data = response.read().decode('utf-8', errors='replace')\\n            print(f\\\"{api_url}: {data[:200]}\\\")\\n    except Exception as e:\\n        print(f\\\"{api_url}: {e}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5444256 role=server
timestamp=2026-10-24T08:38:25.449Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nfrom urllib.parse import unquote\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n}\\n\\n# Try to get the DoodStream video URL using the file ID\\n# DoodStream file: 8rrwpuv9srfef6aa\\n# Video ID: wyr99ofrib7b\\n\\n# Try to access the video page through different domains\\nimport http.client\\n\\nfile_id = \\\"8rrwpuv9srfef7b\\\"  # typo\\nfile_id = \\\"8rrwpuv9srfef6aa\\\"\\n\\n# Try the DoodStream CDN domains for direct file access\\ncdn_domains = [\\n    \\\"doodcdn.io\\\",\\n    \\\"ddog.pro\\\",\\n    \\\"ddogs.pro\\\",\\n    \\\"d00d.pro\\\",\\n    \\\"d00d.ws\\\",\\n    \\\"d00d.li\\\",\\n    \\\"d00d.to\\\",\\n    \\\"d00dstream.com\\\",\\n    \\\"d00dstream.net\\\",\\n    \\\"d00dstream.org\\\",\\n]\\n\\n# Also try the imgds.net domain (used for thumbnails)\\nprint(\\\"=== Trying imgds.net for video file ===\\\")\\ntry:\\n    url = f\\\"https://imgds.net/files/{file_id}.mp4\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        print(f\\\"  {url}\\\")\\n        print(f\\\"  Status: {response.status}\\\")\\n        print(f\\\"  CT: {response.headers.get('Content-Type', 'unknown')}\\\")\\n        print(f\\\"  CL: {response.headers.get('Content-Length', 'unknown')}\\\")\\nexcept Exception as e:\\n    print(f\\\"  Error: {e}\\\")\\n\\n# Try the doodcdn.io domain\\nprint(\\\"\\\\n=== Trying doodcdn.io ===\\\")\\ntry:\\n    url = f\\\"https://i.doodcdn.io/files/{file_id}/video.mp4\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        print(f\\\"  {url}\\\")\\n        print(f\\\"  Status: {response.status}\\\")\\n        print(f\\\"  CT: {response.headers.get('Content-Type', 'unknown')}\\\")\\nexcept Exception as e:\\n    print(f\\\"  Error: {e}\\\")\\n\\n# Try the dood.ws domain with the embed page\\nprint(\\\"\\\\n=== Getting dood.ws embed page ===\\\")\\ntry:\\n    url = f\\\"https://dood.ws/e/{file_id}\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=5) as response:\\n        page = response.read().decode('utf-8', errors='replace')\\n        print(f\\\"  Status: {response.status}\\\")\\n        print(f\\\"  Size: {len(page)}\\\")\\n        \\n        # Look for video source\\n        mp4 = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', page)\\n        for m in mp4:\\n            print(f\\\"  MP4: {m}\\\")\\n        \\n        # Look for any URL\\n        urls = re.findall(r'https?://[^\\\\'\\\"<>\\\\s]+', page)\\n        for u in urls:\\n            if len(u) > 10 and 'cdn' in u.lower() or 'dood' in u.lower():\\n                print(f\\\"  URL: {u[:200]}\\\")\\nexcept Exception as e:\\n    print(f\\\"  Error: {e}\\\")\\n\\n# Try to get the video URL from the KittyKawai page for a working video\\nprint(\\\"\\\\n=== Working video comparison ===\\\")\\n# Get the page for Arachu Viral 3 which had a working MP4\\nurl = \\\"https://kittykawai.com/arachu-viral-3-bokep-indo-viral-g8euht/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    working_page = response.read().decode('utf-8', errors='replace')\\n\\n# Find the video element in the working page\\nprint(\\\"Working page video elements:\\\")\\nvideo_elements = re.findall(r'<(video|source|iframe)[^>]*>', working_page, re.I)\\nfor ve in video_elements:\\n    print(f\\\"  {ve[:300]}\\\")\\n\\n# Find the iframe src in working page\\niframes = re.findall(r'src=\\\"(https?://[^\\\"]*)\\\"', working_page)\\nfor iframe in iframes:\\n    print(f\\\"  Iframe: {iframe[:200]}\\\")\\n\\n# Get the page for the failed video\\nprint(\\\"\\\\n=== Failed video page ===\\\")\\nurl2 = \\\"https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/\\\"\\nreq2 = urllib.request.Request(url2, headers=headers)\\nwith urllib.request.urlopen(req2, timeout=10) as response2:\\n    failed_page = response2.read().decode('utf-8', errors='replace')\\n\\n# Compare video elements\\nprint(\\\"Failed page video elements:\\\")\\nvideo_elements2 = re.findall(r'<(video|source|iframe)[^>]*>', failed_page, re.I)\\nfor ve in video_elements2:\\n    print(f\\\"  {ve[:300]}\\\")\\n\\n# Find the iframe src in failed page\\niframes2 = re.findall(r'src=\\\"(https?://[^\\\"]*)\\\"', failed_page)\\nfor iframe in iframes2:\\n    if 'playmogo' in iframe or 'dood' in iframe or 'video' in iframe.lower():\\n        print(f\\\"  Iframe: {iframe[:200]}\\\")\\n\\n# Check if the failed page has a different iframe pattern\\nprint(\\\"\\\\n=== Comparing iframe patterns ===\\\")\\n# Working page iframe\\nworking_iframe = re.findall(r'player-x\\\\.php\\\\?q=([a-zA-Z0-9+/=]+)', working_page)\\nprint(f\\\"Working page iframe q param length: {len(working_iframe[0]) if working_iframe else 'N/A'}\\\")\\n\\n# Failed page iframe\\nfailed_iframe = re.findall(r'player-x\\\\.php\\\\?q=([a-zA-Z0-9+/=]+)', failed_page)\\nprint(f\\\"Failed page iframe q param length: {len(failed_iframe[0]) if failed_iframe else 'N/A'}\\\")\\n\\n# Failed page might have a different pattern\\nif not failed_iframe:\\n    failed_iframes = re.findall(r'src=\\\"(https?://[^\\\"]*playmogo[^\\\"]*)\\\"', failed_page)\\n    for fi in failed_iframes:\\n        print(f\\\"  Failed page playmogo iframe: {fi[:200]}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5470866 role=server
timestamp=2026-10-24T08:38:43.281Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.cookiejar\\nimport base64\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n}\\n\\n# Get all Arachu video pages from the tag page\\nurl = \\\"https://kittykawai.com/tag/arachu-bokep/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    page = response.read().decode('utf-8', errors='replace')\\n\\n# Get all video page URLs\\nvideo_urls = re.findall(r'href=\\\"(https://kittykawai\\\\.com/[^\\\"]*arachu[^\\\"]*/)\\\"', page)\\nvideo_urls = sorted(set(video_urls))\\n\\nall_links = []\\n\\nfor vurl in video_urls:\\n    try:\\n        req2 = urllib.request.Request(vurl, headers=headers)\\n        with urllib.request.urlopen(req2, timeout=10) as response2:\\n            vpage = response2.read().decode('utf-8', errors='replace')\\n        \\n        title_match = re.search(r'<title>([^<]+)</title>', vpage)\\n        title = title_match.group(1).replace(' - KittyKawai', '').replace(' - KittyKawai.com', '') if title_match else vurl.split('/')[-2]\\n        \\n        mp4_url = None\\n        \\n        # Method 1: Check for base64 encoded iframe with Clean Tube Player\\n        iframe_match = re.search(r'player-x\\\\.php\\\\?q=([a-zA-Z0-9+/=]+)', vpage)\\n        if iframe_match:\\n            q_value = iframe_match.group(1)\\n            # Add base64 padding\\n            padding = 4 - (len(q_value) % 4)\\n            if padding != 4:\\n                q_value += '=' * padding\\n            try:\\n                decoded = base64.b64decode(q_value).decode('utf-8', errors='replace')\\n                mp4_match = re.search(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4[^\\\\'\\\"<>\\\\s]*)', decoded)\\n                if mp4_match:\\n                    mp4_url = mp4_match.group(1)\\n            except:\\n                pass\\n        \\n        # Method 2: Direct MP4 URL in page\\n        if not mp4_url:\\n            mp4_match = re.search(r'(cdn\\\\.dogestream\\\\.live/videos/[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', vpage)\\n            if mp4_match:\\n                mp4_url = \\\"https://\\\" + mp4_match.group(1)\\n        \\n        # Method 3: Check for playmogo embed - try to get the video URL\\n        if not mp4_url:\\n            pm_match = re.search(r'https?://playmogo\\\\.com/e/([a-zA-Z0-9]+)', vpage)\\n            if pm_match:\\n                video_id = pm_match.group(1)\\n                # Try to get the video from DoodStream API\\n                # The public API endpoint for DoodStream\\n                api_url = f\\\"https://doodapi.com/api/doodstream/{video_id}\\\"\\n                try:\\n                    req3 = urllib.request.Request(api_url, headers={**headers, 'Referer': 'https://kittykawai.com/'})\\n                    with urllib.request.urlopen(req3, timeout=5) as response3:\\n                        import json\\n                        data = json.loads(response3.read().decode('utf-8', errors='replace'))\\n                        if 'download_link' in data:\\n                            mp4_url = data['download_link']\\n                        elif 'file_info' in data and 'download_link' in data['file_info']:\\n                            mp4_url = data['file_info']['download_link']\\n                except:\\n                    pass\\n        \\n        if mp4_url:\\n            all_links.append((title, mp4_url))\\n        else:\\n            # Check if it's a playmogo embed\\n            pm_match = re.search(r'https?://playmogo\\\\.com/e/([a-zA-Z0-9]+)', vpage)\\n            if pm_match:\\n                print(f\\\"⚠️ {title} - DoodStream embed (captcha-protected)\\\")\\n                print(f\\\"   Video ID: {pm_match.group(1)}\\\")\\n                print(f\\\"   URL: {vurl}\\\")\\n                print()\\n            else:\\n                print(f\\\"⚠️ {title} - No MP4 found\\\")\\n                print(f\\\"   URL: {vurl}\\\")\\n                print()\\n            \\n    except Exception as e:\\n        print(f\\\"⚠️ {vurl}: {e}\\\")\\n        print()\\n\\nprint(\\\"=\\\" * 80)\\nprint(f\\\"SUCCESSFUL LINKS: {len(all_links)}\\\")\\nprint(\\\"=\\\" * 80)\\n\\nfor i, (title, url) in enumerate(all_links, 1):\\n    safe = title.replace(' ', '_').replace('/', '_').replace('(', '').replace(')', '')\\n    print(f\\\"\\\\n{i}. {title}\\\")\\n    print(f\\\"   🔗 {url}\\\")\\n\\n# Save results\\nwith open('/tmp/arachu_mp4_links.txt', 'w') as f:\\n    f.write(\\\"# BOKEP ARACHU VIRAL - DIRECT MP4 DOWNLOAD LINKS\\\\n\\\")\\n    f.write(\\\"# \\\" + \\\"=\\\" * 76 + \\\"\\\\n\\\\n\\\")\\n    \\n    for i, (title, url) in enumerate(all_links, 1):\\n        safe = title.replace(' ', '_').replace('/', '_').replace('(', '').replace(')', '')\\n        f.write(f\\\"{i}. {title}\\\\n\\\")\\n        f.write(f\\\"   {url}\\\\n\\\")\\n        f.write(f\\\"   wget -O 'arachu_{safe}.mp4' '{url}'\\\\n\\\\n\\\")\\n    \\n    f.write(\\\"\\\\n# CAPTCHA-PROTECTED LINKS (DoodStream)\\\\n\\\")\\n    f.write(\\\"# \\\" + \\\"=\\\" * 76 + \\\"\\\\n\\\")\\n\\nprint(f\\\"\\\\n✅ Saved to /tmp/arachu_mp4_links.txt\\\")\\nPYEOF\"]" cwd=/home/runner http.span=5488698 role=server
