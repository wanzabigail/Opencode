timestamp=2026-10-24T08:35:12.320Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport base64\\nfrom urllib.parse import unquote\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\\n}\\n\\n# Get all actual Arachu video page URLs from the tag page\\nurl = \\\"https://kittykawai.com/tag/arachu-bokep/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    page = response.read().decode('utf-8', errors='replace')\\n\\n# Extract all Arachu video page URLs (full URLs in hrefs)\\nvideo_urls = re.findall(r'href=\\\"(https://kittykawai\\\\.com/[^\\\"]*arachu[^\\\"]*/)\\\"', page)\\nvideo_urls = sorted(set(video_urls))\\nprint(f\\\"Found {len(video_urls)} Arachu video pages\\\\n\\\")\\n\\nall_links = []\\n\\nfor vurl in video_urls:\\n    try:\\n        req2 = urllib.request.Request(vurl, headers=headers)\\n        with urllib.request.urlopen(req2, timeout=10) as response2:\\n            vpage = response2.read().decode('utf-8', errors='replace')\\n        \\n        title_match = re.search(r'<title>([^<]+)</title>', vpage)\\n        title = title_match.group(1).replace(' - KittyKawai', '').replace(' - KittyKawai.com', '') if title_match else vurl.split('/')[-2]\\n        \\n        mp4_url = None\\n        \\n        # Method 1: Check for base64 encoded iframe with Clean Tube Player\\n        iframe_match = re.search(r'src=\\\"(https://kittykawai\\\\.com/wp-content/plugins/clean-tube-player/public/player-x\\\\.php\\\\?q=([^\\\"]+))\\\"', vpage)\\n        if iframe_match:\\n            q_value = iframe_match.group(2)\\n            # Add base64 padding\\n            padding = 4 - (len(q_value) % 4)\\n            if padding != 4:\\n                q_value += '=' * padding\\n            try:\\n                decoded = base64.b64decode(q_value).decode('utf-8', errors='replace')\\n                # Extract MP4 URL\\n                mp4_match = re.search(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4[^\\\\'\\\"<>\\\\s]*)', decoded)\\n                if mp4_match:\\n                    mp4_url = mp4_match.group(1)\\n            except:\\n                pass\\n        \\n        # Method 2: Direct MP4 URL in page source\\n        if not mp4_url:\\n            mp4_match = re.search(r'(cdn\\\\.dogestream\\\\.live/videos/[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', vpage)\\n            if mp4_match:\\n                mp4_url = \\\"https://\\\" + mp4_match.group(1)\\n        \\n        if mp4_url:\\n            all_links.append((title, mp4_url))\\n            print(f\\\"✅ {title}\\\")\\n            print(f\\\"   🔗 {mp4_url}\\\")\\n            print()\\n        else:\\n            print(f\\\"⚠️ {title} - No MP4 found\\\")\\n            \\n    except urllib.error.HTTPError as e:\\n        print(f\\\"⚠️ {vurl} - HTTP {e.code}\\\")\\n    except Exception as e:\\n        print(f\\\"⚠️ {vurl} - {e}\\\")\\n\\nprint(\\\"=\\\" * 80)\\nprint(f\\\"TOTAL: {len(all_links)} DIRECT MP4 LINKS FOUND\\\")\\nprint(\\\"=\\\" * 80)\\n\\n# Save results\\nwith open('/tmp/arachu_mp4_links.txt', 'w') as f:\\n    f.write(\\\"# BOKEP ARACHU VIRAL - DIRECT MP4 DOWNLOAD LINKS\\\\n\\\")\\n    f.write(\\\"# \\\" + \\\"=\\\" * 76 + \\\"\\\\n\\\\n\\\")\\n    for i, (title, url) in enumerate(all_links, 1):\\n        safe = title.replace(' ', '_').replace('/', '_').replace('(', '').replace(')', '')\\n        f.write(f\\\"{i}. {title}\\\\n\\\")\\n        f.write(f\\\"   {url}\\\\n\\\")\\n        f.write(f\\\"   wget -O 'arachu_{safe}.mp4' '{url}'\\\\n\\\\n\\\")\\n\\nprint(f\\\"\\\\n✅ Saved to /tmp/arachu_mp4_links.txt\\\")\\nPYEOF\"]" cwd=/home/runner http.span=5277737 role=server
timestamp=2026-10-24T08:35:26.463Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport base64\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\\n}\\n\\n# Videos that failed - try to find their MP4 via different approach\\nfailed_videos = [\\n    \\\"https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-arachu-colmek-cosplay-bunnies-pakai-dildo/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-arachu-colmek-kangen-kontol-asli/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-arachu-colmek-pakai-vibrator-mendesah-bikin-sange/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-arachu-colmek-pengen-di-entot-sange-parah/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-arachu-halloween-mainin-vibrator-seksi-banget/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-update-konten-arachu-terbaru-pamer-toket-dan-colmek/\\\",\\n    \\\"https://kittykawai.com/bokep-indo-update-konten-arachu-terbaru-pamer-toket-mulus-banget/\\\",\\n    \\\"https://kittykawai.com/bokep-onlyfans-arachu-x-dea-ayu/\\\",\\n    \\\"https://kittykawai.com/arachu-x-dea-onlyfans-t-me-sange/\\\",\\n    \\\"https://kittykawai.com/arachuu-cosplay-spiderman-cewek-sexy/\\\",\\n]\\n\\nfor vurl in failed_videos:\\n    try:\\n        req = urllib.request.Request(vurl, headers=headers)\\n        with urllib.request.urlopen(req, timeout=10) as response:\\n            vpage = response.read().decode('utf-8', errors='replace')\\n        \\n        # Find ALL data attributes that might contain post IDs\\n        post_id_matches = re.findall(r'data-post_id=\\\"(\\\\d+)\\\"', vpage)\\n        post_ids = list(set(post_id_matches))\\n        \\n        # Find any video-related data\\n        video_data = re.findall(r'wpst-video-id[^>]*>', vpage)\\n        print(f\\\"Page: {vurl.split('/')[-2]}\\\")\\n        print(f\\\"  Post IDs: {post_ids}\\\")\\n        \\n        if post_ids:\\n            for pid in post_ids:\\n                # Try the Clean Tube Player API with this post ID\\n                q = f\\\"post_id={pid}&type=video\\\"\\n                encoded = base64.b64encode(q.encode()).decode()\\n                player_url = f\\\"https://kittykawai.com/wp-content/plugins/clean-tube-player/public/player-x.php?q={encoded}\\\"\\n                \\n                req2 = urllib.request.Request(player_url, headers=headers)\\n                try:\\n                    with urllib.request.urlopen(req2, timeout=5) as resp2:\\n                        player_page = resp2.read()\\n                        if player_page:\\n                            # Try decoding the response\\n                            if player_page[:2] == b'\\\\x1f\\\\x8b':\\n                                import gzip\\n                                player_page = gzip.decompress(player_page).decode('utf-8', errors='replace')\\n                            else:\\n                                player_page = player_page.decode('utf-8', errors='replace')\\n                            \\n                            print(f\\\"  Player page (post_id={pid}): {len(player_page)} chars\\\")\\n                            # Look for MP4\\n                            mp4 = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', player_page)\\n                            if mp4:\\n                                for m in mp4:\\n                                    print(f\\\"    MP4: {m}\\\")\\n                        else:\\n                            print(f\\\"  Player page (post_id={pid}): empty response\\\")\\n                except Exception as e:\\n                    print(f\\\"  Player page (post_id={pid}): {e}\\\")\\n        \\n        print()\\n    except Exception as e:\\n        print(f\\\"⚠️ {vurl}: {e}\\\")\\n        print()\\nPYEOF\"]" cwd=/home/runner http.span=5291880 role=server
timestamp=2026-10-24T08:35:41.243Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\\n}\\n\\n# Check the actual HTML structure of one of the failed pages\\nurl = \\\"https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    vpage = response.read().decode('utf-8', errors='replace')\\n\\n# Save to file for inspection\\nwith open('/tmp/failed_page.html', 'w') as f:\\n    f.write(vpage)\\n\\nprint(\\\"=== Looking for video element in page ===\\\")\\n\\n# Look for video tags\\nvideo_tags = re.findall(r'<video[^>]*>.*?</video>', vpage, re.DOTALL)\\nfor vt in video_tags:\\n    print(f\\\"Video tag: {vt[:300]}\\\")\\n\\n# Look for source tags\\nsource_tags = re.findall(r'<source[^>]*>', vpage)\\nfor st in source_tags:\\n    print(f\\\"Source: {st}\\\")\\n\\n# Look for any iframe\\niframes = re.findall(r'<iframe[^>]*>', vpage)\\nfor iframe in iframes:\\n    print(f\\\"Iframe: {iframe}\\\")\\n\\n# Look for data attributes\\ndata_post_id = re.findall(r'data-post_id=\\\"(\\\\d+)\\\"', vpage)\\nprint(f\\\"\\\\nData post IDs: {data_post_id}\\\")\\n\\n# Look for any CDN URL\\ncdn_urls = re.findall(r'(https?://cdn[^\\\\'\\\"<>\\\\s]+)', vpage)\\nfor cu in cdn_urls:\\n    print(f\\\"CDN URL: {cu}\\\")\\n\\n# Look for dogestream\\ndogestream = re.findall(r'(dogestream[^\\\\'\\\"<>\\\\s]+)', vpage)\\nfor ds in dogestream:\\n    print(f\\\"Dogestream: {ds}\\\")\\n\\n# Look for any video/mp4 reference in meta tags\\nmeta_content = re.findall(r'<meta[^>]*content=\\\"([^\\\"]*dogestream[^\\\"]*)\\\"', vpage)\\nfor mc in meta_content:\\n    print(f\\\"Meta: {mc}\\\")\\n\\n# Look for og:video\\nog_video = re.findall(r'<meta[^>]*property=\\\"og:video\\\"[^>]*content=\\\"([^\\\"]*)\\\"', vpage)\\nfor ov in og_video:\\n    print(f\\\"OG Video: {ov}\\\")\\n\\n# Look for embed URL\\nembed_match = re.findall(r'https?://playmogo\\\\.com/[ed]/\\\\w+', vpage)\\nfor em in embed_match:\\n    print(f\\\"Embed: {em}\\\")\\n\\n# Look for doodstream reference\\ndoodstream = re.findall(r'(dood(stream|ws|\\\\.li|\\\\.to|\\\\.la)?[^\\\\s\\\\'\\\"<>\\\\\\\"]*)', vpage)\\nfor ds in set(doodstream):\\n    print(f\\\"Dood: {ds}\\\")\\n\\nprint(\\\"\\\\n=== Checking page size ===\\\")\\nprint(f\\\"Page size: {len(vpage)} chars\\\")\\n\\n# Find the article/post section\\narticle = re.search(r'<article[^>]*id=\\\"post-311016\\\"[^>]*>(.*?)</article>', vpage, re.DOTALL)\\nif article:\\n    content = article.group(1)\\n    print(f\\\"Article content length: {len(content)}\\\")\\n    # Look for video-related elements in article\\n    video_content = re.findall(r'(video|mp4|source|iframe|embed|dood|dogestream|cdn)[^<]*', content[:5000], re.I)\\n    print(f\\\"Video-related in article: {video_content[:20]}\\\")\\nPYEOF\"]" cwd=/home/runner http.span=5306660 role=server
timestamp=2026-10-24T08:35:50.608Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\\n}\\n\\n# Get the full page for the main Arachu video\\nurl = \\\"https://kittykawai.com/bokep-indo-arachu-cantik-mulus-pamer-tobrut-dan-colmek/\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    vpage = response.read().decode('utf-8', errors='replace')\\n\\n# Look for JavaScript variables with video URLs\\nprint(\\\"=== JavaScript video variables ===\\\")\\nscripts = re.findall(r'<script[^>]*>(.*?)</script>', vpage, re.DOTALL)\\nfor script in scripts:\\n    # Look for video URL patterns in JS\\n    urls = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+)', script)\\n    for u in urls:\\n        if 'mp4' in u.lower() or 'video' in u.lower() or 'stream' in u.lower() or 'dogestream' in u.lower() or 'dood' in u.lower():\\n            print(f\\\"  {u[:200]}\\\")\\n\\n# Look for wpst-post-id or similar data attributes  \\nprint(\\\"\\\\n=== Video data attributes ===\\\")\\ndata_attrs = re.findall(r'(data-[a-z-]+)=[\\\"\\\\']([^\\\"\\\\']+)[\\\"\\\\']', vpage)\\nfor attr, val in data_attrs:\\n    if any(kw in attr.lower() for kw in ['video', 'mp4', 'player', 'embed', 'dood', 'stream']):\\n        print(f\\\"  {attr} = {val[:200]}\\\")\\n\\n# Look for the video player config in JSON\\nprint(\\\"\\\\n=== JSON video data ===\\\")\\njson_videos = re.findall(r'application/ld\\\\+json\\\">(.*?)</script>', vpage, re.DOTALL)\\nfor jv in json_videos:\\n    if 'video' in jv.lower() or 'embed' in jv.lower():\\n        # Extract video URL from JSON-LD\\n        video_url = re.search(r'\\\"contentUrl\\\"\\\\s*:\\\\s*\\\"([^\\\"]+)\\\"', jv)\\n        if video_url:\\n            print(f\\\"  Content URL: {video_url.group(1)}\\\")\\n        embed_url = re.search(r'\\\"embedUrl\\\"\\\\s*:\\\\s*\\\"([^\\\"]+)\\\"', jv)\\n        if embed_url:\\n            print(f\\\"  Embed URL: {embed_url.group(1)}\\\")\\n\\n# Check the article for any embedded video data\\nprint(\\\"\\\\n=== Article content video references ===\\\")\\narticle_match = re.search(r'<article[^>]*id=\\\"post-311016\\\"[^>]*>(.*?)</article>', vpage, re.DOTALL)\\nif article_match:\\n    article = article_match.group(1)\\n    # Look for all hrefs in article\\n    hrefs = re.findall(r'href=\\\"([^\\\"]+)\\\"', article)\\n    for h in hrefs:\\n        if 'mp4' in h.lower() or 'video' in h.lower() or 'dood' in h.lower() or 'dogestream' in h.lower():\\n            print(f\\\"  Article href: {h}\\\")\\n\\n# Also check for any src attributes in article\\nsrcs = re.findall(r'src=\\\"([^\\\"]+)\\\"', article)\\nfor s in srcs:\\n    if 'mp4' in s.lower() or 'video' in s.lower() or 'dood' in s.lower() or 'dogestream' in s.lower():\\n        print(f\\\"  Article src: {s}\\\")\\n\\n# Look for the iframe src specifically in article\\niframe_srcs = re.findall(r'src=\\\"(https?://[^\\\"]+)\\\"', article)\\nfor isrc in iframe_srcs:\\n    print(f\\\"  Article iframe: {isrc}\\\")\\nPYEOF\"]" cwd=/home/runner http.span=5316025 role=server
