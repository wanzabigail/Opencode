timestamp=2026-10-24T08:35:59.176Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.cookiejar\\nimport base64\\n\\n# Use proper session with cookies to bypass Cloudflare\\ncj = http.cookiejar.CookieJar()\\nopener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8',\\n    'Accept-Language': 'en-US,en;q=0.9',\\n    'Accept-Encoding': 'gzip, deflate, br',\\n    'Connection': 'keep-alive',\\n    'Upgrade-Insecure-Requests': '1',\\n}\\n\\n# First get playmogo page to establish session\\nvideo_id = \\\"wyr99ofrib7b\\\"\\nprint(\\\"=== Getting playmogo session ===\\\")\\ntry:\\n    req = urllib.request.Request(\\\"https://playmogo.com/\\\", headers={'User-Agent': headers['User-Agent']})\\n    with opener.open(req, timeout=10) as response:\\n        response.read()\\n    print(f\\\"Cookies: {[(c.name, c.value[:20]) for c in cj]}\\\")\\nexcept Exception as e:\\n    print(f\\\"Session error: {e}\\\")\\n\\n# Now get the embed page\\nprint(\\\"\\\\n=== Getting embed page ===\\\")\\nurl = f\\\"https://playmogo.com/e/{video_id}\\\"\\nreq = urllib.request.Request(url, headers={**headers, 'Referer': 'https://playmogo.com/'})\\ntry:\\n    with opener.open(req, timeout=15) as response:\\n        page = response.read().decode('utf-8', errors='replace')\\n    \\n    print(f\\\"Page size: {len(page)}\\\")\\n    \\n    # Save full page\\n    with open('/tmp/playmogo_embed.html', 'w') as f:\\n        f.write(page)\\n    \\n    # Look for video URL\\n    print(\\\"\\\\n=== Looking for video URLs ===\\\")\\n    \\n    # Direct MP4\\n    mp4s = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4[^\\\\'\\\"<>\\\\s]*)', page)\\n    for m in mp4s:\\n        print(f\\\"  MP4: {m}\\\")\\n    \\n    # Source URL\\n    sources = re.findall(r'src=\\\"([^\\\"]*dood[^\\\"]*)\\\"', page)\\n    for s in sources:\\n        print(f\\\"  Source: {s}\\\")\\n    \\n    # Data attributes\\n    data_urls = re.findall(r'data-src=\\\"([^\\\"]*)\\\"', page)\\n    for d in data_urls:\\n        print(f\\\"  data-src: {d}\\\")\\n    \\n    # Video config in JSON\\n    json_urls = re.findall(r'\\\"(video_url|videoSrc|embed_src|file)\\\"\\\\s*:\\\\s*\\\"([^\\\"]*)\\\"', page)\\n    for k, v in json_urls:\\n        print(f\\\"  JSON {k}: {v}\\\")\\n    \\n    # Look for the iframe src in the page\\n    iframes = re.findall(r'<iframe[^>]*src=\\\"([^\\\"]*)\\\"', page)\\n    for iframe in iframes:\\n        print(f\\\"  Iframe: {iframe}\\\")\\n    \\n    # Look for any URL containing video/stream/file\\n    all_urls = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+)', page)\\n    for u in all_urls:\\n        if any(kw in u.lower() for kw in ['video', 'stream', 'file', 'dood', 'mp4', 'embed']):\\n            print(f\\\"  URL: {u[:200]}\\\")\\n    \\nexcept Exception as e:\\n    print(f\\\"Error: {e}\\\")\\n    import traceback\\n    traceback.print_exc()\\nPYEOF\"]" cwd=/home/runner http.span=5324593 role=server
timestamp=2026-10-24T08:36:17.986Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.cookiejar\\n\\ncj = http.cookiejar.CookieJar()\\nopener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\\n\\nvideo_id = \\\"wyr99ofrib7b\\\"\\n\\n# Get the embed page raw content\\nurl = f\\\"https://playmogo.com/e/{video_id}\\\"\\nreq = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36'})\\n\\nwith opener.open(req, timeout=15) as response:\\n    raw = response.read()\\n    \\n# Try decoding brotli/compressed content\\ntry:\\n    import brotli\\n    content = brotli.decompress(raw).decode('utf-8', errors='replace')\\nexcept:\\n    import gzip\\n    try:\\n        content = gzip.decompress(raw).decode('utf-8', errors='replace')\\n    except:\\n        content = raw.decode('utf-8', errors='replace')\\n\\nprint(f\\\"Decoded content ({len(content)} bytes):\\\")\\nprint(content)\\n\\n# Also try the download endpoint\\nprint(\\\"\\\\n=== Trying download endpoint ===\\\")\\nurl2 = f\\\"https://playmogo.com/d/{video_id}\\\"\\nreq2 = urllib.request.Request(url2, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36', 'Referer': f'https://playmogo.com/e/{video_id}'})\\n\\nwith opener.open(req2, timeout=15) as response2:\\n    raw2 = response2.read()\\n    try:\\n        import brotli\\n        content2 = brotli.decompress(raw2).decode('utf-8', errors='replace')\\n    except:\\n        content2 = raw2.decode('utf-8', errors='replace')\\n    \\n    print(f\\\"Download page ({len(content2)} bytes):\\\")\\n    print(content2)\\n    \\n    # Look for video URLs\\n    mp4s = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4)', content2)\\n    for m in mp4s:\\n        print(f\\\"  MP4: {m}\\\")\\n    \\n    # Look for any iframe or video source\\n    iframes = re.findall(r'src=\\\"([^\\\"]*)\\\"', content2)\\n    for i in iframes:\\n        print(f\\\"  Iframe: {i}\\\")\\n    \\n    # Look for video config\\n    urls = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+)', content2)\\n    for u in urls:\\n        print(f\\\"  URL: {u[:200]}\\\")\\nPYEOF\"]" cwd=/home/runner http.span=5343403 role=server
timestamp=2026-10-24T08:36:32.682Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.client\\nfrom urllib.parse import urlparse\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n    'Referer': 'https://playmogo.com/',\\n}\\n\\nfile_id = \\\"8rrwpuv9srfef6aa\\\"\\nvideo_id = \\\"wyr99ofrib7b\\\"\\n\\n# Try different DoodStream CDN domains for direct file access\\ncdn_patterns = [\\n    (\\\"doodstream.com\\\", f\\\"/d/{video_id}\\\"),\\n    (\\\"dood.ws\\\", f\\\"/d/{video_id}\\\"),\\n    (\\\"dood.li\\\", f\\\"/d/{video_id}\\\"),\\n    (\\\"doodstream.com\\\", f\\\"/e/{video_id}\\\"),\\n    (\\\"dood.ws\\\", f\\\"/e/{video_id}\\\"),\\n    (\\\"d0000d.com\\\", f\\\"/d/{video_id}\\\"),\\n    (\\\"d0000d.org\\\", f\\\"/d/{video_id}\\\"),\\n]\\n\\nprint(\\\"=== Trying different DoodStream domains ===\\\")\\nfor domain, path in cdn_patterns:\\n    try:\\n        conn = http.client.HTTPSConnection(domain, timeout=5)\\n        conn.request('GET', path, headers={\\n            'User-Agent': headers['User-Agent'],\\n            'Referer': 'https://www.google.com/',\\n        })\\n        resp = conn.getresponse()\\n        ct = resp.getheader('Content-Type', '')\\n        cl = resp.getheader('Content-Length', '')\\n        loc = resp.getheader('Location', '')\\n        print(f\\\"  {domain}{path}\\\")\\n        print(f\\\"    Status: {resp.status}, CT: {ct}, CL: {cl}\\\")\\n        if loc:\\n            print(f\\\"    Redirect: {loc}\\\")\\n        body = resp.read()\\n        print(f\\\"    Body: {len(body)} bytes\\\")\\n        if len(body) > 100:\\n            print(f\\\"    Preview: {body[:100]}\\\")\\n        resp.read()\\n    except Exception as e:\\n        print(f\\\"  {domain}{path}: {e}\\\")\\n\\n# Try the API endpoint\\nprint(\\\"\\\\n=== DoodStream API ===\\\")\\ntry:\\n    api_url = f\\\"https://doodapi.com/api/resapi/4/{video_id}\\\"\\n    req = urllib.request.Request(api_url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=10) as response:\\n        data = response.read().decode('utf-8', errors='replace')\\n        print(f\\\"API: {data[:300]}\\\")\\nexcept Exception as e:\\n    print(f\\\"API Error: {e}\\\")\\n\\n# Try to get direct video link from /d/ page\\nprint(\\\"\\\\n=== Direct file access patterns ===\\\")\\nfile_patterns = [\\n    f\\\"https://doodstream.com/d/{video_id}\\\",\\n    f\\\"https://dood.ws/d/{video_id}\\\",\\n    f\\\"https://d0000d.com/d/{video_id}\\\",\\n    f\\\"https://d0000d.org/d/{video_id}\\\",\\n]\\n\\nfor pattern in file_patterns:\\n    try:\\n        req = urllib.request.Request(pattern, headers=headers)\\n        with urllib.request.urlopen(req, timeout=10) as response:\\n            final = response.geturl()\\n            ct = response.headers.get('Content-Type', '')\\n            print(f\\\"  {pattern}\\\")\\n            print(f\\\"    Final: {final}\\\")\\n            print(f\\\"    CT: {ct}\\\")\\n    except urllib.error.HTTPError as e:\\n        print(f\\\"  {pattern}: HTTP {e.code}\\\")\\n    except Exception as e:\\n        print(f\\\"  {pattern}: {e}\\\")\\n\\n# Try to get the video page and look for the actual video source\\nprint(\\\"\\\\n=== Parsing DoodStream page for video source ===\\\")\\ntry:\\n    url = f\\\"https://dood.ws/d/{video_id}\\\"\\n    req = urllib.request.Request(url, headers=headers)\\n    with urllib.request.urlopen(req, timeout=10) as response:\\n        page = response.read().decode('utf-8', errors='replace')\\n    \\n    # Look for any JavaScript variable with video URL\\n    js_vars = re.findall(r'(?:video_url|file|source|url)\\\\s*[:=]\\\\s*[\\\\'\\\"]([^\\\\'\\\"]+)[\\\\'\\\"]', page)\\n    for jv in js_vars:\\n        print(f\\\"  JS var: {jv}\\\")\\n    \\n    # Look for the iframe src in the player\\n    iframe_match = re.search(r'<iframe[^>]*src=\\\"([^\\\"]+)\\\"', page)\\n    if iframe_match:\\n        print(f\\\"  Iframe src: {iframe_match.group(1)}\\\")\\n    \\n    # Look for download link\\n    dl_match = re.search(r'href=\\\"([^\\\"]+download[^\\\"]+)\\\"', page)\\n    if dl_match:\\n        print(f\\\"  Download link: {dl_match.group(1)}\\\")\\n    \\n    # Check for any .mp4 reference\\n    mp4_match = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4[^\\\\'\\\"<>\\\\s]*)', page)\\n    for m in mp4_match:\\n        print(f\\\"  MP4: {m}\\\")\\n    \\nexcept Exception as e:\\n    print(f\\\"Error: {e}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5358099 role=server
timestamp=2026-10-24T08:36:54.950Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\nimport http.cookiejar\\nimport json\\n\\ncj = http.cookiejar.CookieJar()\\nopener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\\n\\nvideo_id = \\\"wyr99ofrib7b\\\"\\nfile_id = \\\"8rrwpuv9srfef6aa\\\"\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n    'Accept': '*/*',\\n    'Referer': 'https://playmogo.com/',\\n}\\n\\n# Get cookies from playmogo first\\nprint(\\\"=== Getting session cookies ===\\\")\\nreq = urllib.request.Request(\\\"https://playmogo.com/\\\", headers={'User-Agent': headers['User-Agent']})\\nwith opener.open(req, timeout=10) as response:\\n    response.read()\\n\\nprint(f\\\"Cookies: {[(c.name, c.value[:30]) for c in cj]}\\\")\\n\\n# Try to get the embed page with cookies\\nprint(\\\"\\\\n=== Getting embed page with cookies ===\\\")\\nembed_url = f\\\"https://playmogo.com/e/{video_id}\\\"\\nreq = urllib.request.Request(embed_url, headers={**headers, 'Referer': 'https://playmogo.com/'})\\nwith opener.open(req, timeout=15) as response:\\n    embed_page = response.read().decode('utf-8', errors='replace')\\n    \\n# Look for any hidden video URL\\nprint(f\\\"Embed page size: {len(embed_page)}\\\")\\n\\n# Try the download page with cookies\\nprint(\\\"\\\\n=== Getting download page with cookies ===\\\")\\ndl_url = f\\\"https://playmogo.com/d/{video_id}\\\"\\nreq2 = urllib.request.Request(dl_url, headers={**headers, 'Referer': 'https://playmogo.com/'})\\nwith opener.open(req2, timeout=15) as response:\\n    dl_page = response.read().decode('utf-8', errors='replace')\\n\\nprint(f\\\"Download page size: {len(dl_page)}\\\")\\n\\n# Save the page\\nwith open('/tmp/playmogo_dl.html', 'w') as f:\\n    f.write(dl_page)\\n\\n# Look for any script that contains video URL\\nscripts = re.findall(r'<script[^>]*>(.*?)</script>', dl_page, re.DOTALL)\\nfor script in scripts:\\n    # Look for video URL\\n    urls = re.findall(r'https?://[^\\\\'\\\"<>\\\\s]+', script)\\n    for u in urls:\\n        if len(u) > 20 and ('dood' in u.lower() or 'mp4' in u.lower() or 'video' in u.lower() or 'stream' in u.lower()):\\n            print(f\\\"  Script URL: {u[:200]}\\\")\\n    \\n    # Look for file ID usage\\n    if file_id in script:\\n        print(f\\\"  Script contains file_id\\\")\\n    \\n    # Look for video config\\n    if 'video_player' in script or 'video_url' in script:\\n        print(f\\\"  Script contains video config\\\")\\n\\n# Look for any download link in the page\\nprint(\\\"\\\\n=== Looking for download links ===\\\")\\ndl_links = re.findall(r'href=\\\"([^\\\"]*)\\\"', dl_page)\\nfor dl in dl_links:\\n    print(f\\\"  Link: {dl}\\\")\\n\\n# Check the iframe src\\niframes = re.findall(r'<iframe[^>]*src=\\\"([^\\\"]*)\\\"', dl_page)\\nfor iframe in iframes:\\n    print(f\\\"  Iframe: {iframe}\\\")\\n\\n# Look for any data attribute with video info\\ndata_attrs = re.findall(r'data-([a-z-]+)=\\\"([^\\\"]*)\\\"', dl_page)\\nfor attr, val in data_attrs:\\n    if 'video' in attr.lower() or 'src' in attr.lower() or 'url' in attr.lower():\\n        print(f\\\"  Data {attr}: {val[:100]}\\\")\\n\\n# Try to get the video via the DoodStream API with file ID\\nprint(\\\"\\\\n=== DoodStream API with file_id ===\\\")\\napi_endpoints = [\\n    f\\\"https://doodapi.com/api/doodstream/{video_id}\\\",\\n    f\\\"https://doodws.com/api/doodstream/{video_id}\\\",\\n    f\\\"https://doodapi.com/api/file/{file_id}\\\",\\n    f\\\"https://dood.ws/api/file/{file_id}\\\",\\n]\\n\\nfor api in api_endpoints:\\n    try:\\n        req = urllib.request.Request(api, headers=headers)\\n        with urllib.request.urlopen(req, timeout=5) as response:\\n            data = response.read().decode('utf-8', errors='replace')\\n            print(f\\\"  {api}: {data[:200]}\\\")\\n    except Exception as e:\\n        print(f\\\"  {api}: {e}\\\")\\n\\n# Try to get the direct video URL from the DoodStream embed page\\n# The captcha is on the embed page, but the /d/ page might have the download link\\nprint(\\\"\\\\n=== Looking for download button in DoodStream page ===\\\")\\ndownload_btn = re.findall(r'class=\\\"download_vd[^\\\"]*\\\"[^>]*href=\\\"([^\\\"]*)\\\"', dl_page)\\nif download_btn:\\n    for db in download_btn:\\n        print(f\\\"  Download button: {db}\\\")\\n\\n# Look for the download onclick handler\\ndl_onclick = re.findall(r'onclick=\\\"([^\\\"]*download[^\\\"]*)\\\"', dl_page)\\nfor dc in dl_onclick:\\n    print(f\\\"  Download onclick: {dc[:100]}\\\")\\n\\n# Look for countdown/download content\\ndownload_content = re.findall(r'class=\\\"download-content[^\\\"]*\\\"[^>]*>(.*?)</div>', dl_page, re.DOTALL)\\nfor dc in download_content:\\n    print(f\\\"  Download content: {dc[:200]}\\\")\\n\\n# Look for any link with mp4 extension\\nmp4_links = re.findall(r'href=\\\"([^\\\"]*\\\\.mp4[^\\\"]*)\\\"', dl_page)\\nfor ml in mp4_links:\\n    print(f\\\"  MP4 link: {ml}\\\")\\n\\n# Look for any .mp4 in the page\\nall_mp4 = re.findall(r'(https?://[^\\\\'\\\"<>\\\\s]+\\\\.mp4[^\\\\'\\\"<>\\\\s]*)', dl_page)\\nfor mp4 in all_mp4:\\n    print(f\\\"  MP4 URL: {mp4}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5380367 role=server
timestamp=2026-10-24T08:37:10.427Z level=INFO run=c07d01c9 message="spawning process" command=/bin/bash args="[\"-c\",\"python3 << 'PYEOF'\\nimport urllib.request\\nimport re\\n\\nheaders = {\\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36',\\n    'Accept': '*/*',\\n}\\n\\n# The DoodStream API needs an API key, but we can try to get the video from the page directly\\n# Let's look at the DoodStream embed page more carefully\\nvideo_id = \\\"wyr99ofrib7b\\\"\\n\\n# Get the dood.ws download page\\nurl = f\\\"https://dood.ws/d/{video_id}\\\"\\nreq = urllib.request.Request(url, headers=headers)\\nwith urllib.request.urlopen(req, timeout=10) as response:\\n    page = response.read().decode('utf-8', errors='replace')\\n\\n# Save to file for inspection\\nwith open('/tmp/dood_download.html', 'w') as f:\\n    f.write(page)\\n\\nprint(f\\\"Page size: {len(page)}\\\")\\n\\n# Look for ALL script content\\nprint(\\\"\\\\n=== ALL script content ===\\\")\\nscripts = re.findall(r'<script[^>]*>(.*?)</script>', page, re.DOTALL)\\nfor i, script in enumerate(scripts):\\n    if len(script) > 0:\\n        print(f\\\"Script {i} ({len(script)} chars):\\\")\\n        print(script[:500])\\n        print()\\n\\n# Look for any variable assignment\\nprint(\\\"\\\\n=== Variable assignments ===\\\")\\nvars = re.findall(r'var\\\\s+(\\\\w+)\\\\s*=\\\\s*([^;]+);', page)\\nfor name, val in vars:\\n    print(f\\\"  {name} = {val[:200]}\\\")\\n\\n# Look for download button configuration\\nprint(\\\"\\\\n=== Download-related ===\\\")\\ndl_config = re.findall(r'download[^}]*', page, re.DOTALL)\\nfor dc in dl_config:\\n    if len(dc) < 300:\\n        print(f\\\"  {dc[:200]}\\\")\\n\\n# Look for player configuration\\nprint(\\\"\\\\n=== Player configuration ===\\\")\\nplayer_config = re.findall(r'player[^}]*', page, re.DOTALL)\\nfor pc in player_config:\\n    if len(pc) < 300:\\n        print(f\\\"  {pc[:200]}\\\")\\n\\n# The /d/ page redirects to /e/ which has the captcha-protected video\\n# Let's try getting the video by following the iframe redirect\\nprint(\\\"\\\\n=== Getting iframe content ===\\\")\\niframe_url = \\\"https://dood.ws/e/wyr99ofrib7b\\\"\\nreq2 = urllib.request.Request(iframe_url, headers={**headers, 'Referer': 'https://dood.ws/d/wyr99ofrib7b'})\\nwith urllib.request.urlopen(req2, timeout=10) as response2:\\n    iframe_page = response2.read().decode('utf-8', errors='replace')\\n\\nwith open('/tmp/dood_embed.html', 'w') as f:\\n    f.write(iframe_page)\\n\\nprint(f\\\"Iframe page size: {len(iframe_page)}\\\")\\n\\n# Look for any video source in the iframe\\nscripts2 = re.findall(r'<script[^>]*>(.*?)</script>', iframe_page, re.DOTALL)\\nfor i, script in enumerate(scripts2):\\n    if len(script) > 0:\\n        print(f\\\"\\\\nIfame Script {i} ({len(script)} chars):\\\")\\n        # Look for URLs\\n        urls = re.findall(r'https?://[^\\\\'\\\"<>\\\\s]+', script)\\n        for u in urls:\\n            print(f\\\"  URL: {u[:200]}\\\")\\n        # Look for variable assignments\\n        vars2 = re.findall(r'var\\\\s+(\\\\w+)\\\\s*=\\\\s*([^;]+);', script)\\n        for name, val in vars2:\\n            print(f\\\"  var {name} = {val[:200]}\\\")\\n\\nPYEOF\"]" cwd=/home/runner http.span=5395844 role=server
